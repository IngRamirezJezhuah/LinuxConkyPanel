conky.config = {
    -- Importacion de archivos 
    lua_load = '/home/djxs4n/.config/conky/draw_bg.lua',
    lua_draw_hook_pre = 'conky_main', -- <--- AQUÍ FALTABA UNA COMA

    -- Ventanas y Bordes
    alignment = 'top_right',
    background = false,
    border_width = 0,
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_graph_borders = false,
    
    own_window = true,
    own_window_type = 'desktop',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 150,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_class = 'Conky',

    -- Dimensiones y Márgenes
    border_inner_margin = 15,
    border_outer_margin = 0,
    gap_x = 30,
    gap_y = 30,
    minimum_width = 250,
    minimum_height = 500, -- Aumentado un poco por si acaso

    -- Rendimiento
    double_buffer = true,
    update_interval = 0.01, -- <- esta wea hace que se vea mas rapido y fluido
    cpu_avg_samples = 2,
    
    -- Estilo
    font = 'JetBrainsMono:size=10',
    default_color = 'B3FFE3',
    color1 = '#0BE08C',
    color2 = '#FF5555',
    color3 = '9B89D9',       
}

conky.text = [[
${voffset 5} ${color1}SISTEMA ${hr}
${image /home/djxs4n/Imagenes/hatusne-miku-hiperrealista.jpg -p 100,10 -s 32x32 }
${color2} ${goto 150} ${voffset 5} Kernel: ${goto 200} ${kernel} ${hr}
${color}Uptime: ${alignr}${uptime}
${color1}ENERGIA ${hr}
${color}Bateria: ${battery_percent}% ${alignr}${battery_bar 8, 100}
${color}Estado: ${alignr}${battery_status}

${color1}PROCESADOR (CPU) ${hr}
${color}Uso: ${cpu cpu0}% ${alignr}${cpugraph 15,200 00ff00 ff0000 -t}
${color}Temp: ${alignr}${hwmon 1 temp 1}°C

${goto 60}CPU${goto 165}RAM 
${voffset 90}
i
${color1}${font :bold:size=11}GRÁFICOS (GPU) ${hr}${font}
${color}Modelo: ${alignr}${execi 60 glxinfo | grep "Device" | cut -d ' ' -f 5-}
${color}Uso GPU: ${alignr}${execi 5 nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo "N/A"}%
${color}VRAM: ${alignr}${execi 5 nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null || echo "0"} MB
${color}Temp GPU: ${alignr}${execi 5 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo "0"}°C

${color1}MEMORIA (RAM) ${hr}
${color}RAM: ${mem} / ${memmax} ${alignr}${memperc}%
${membar 8}
${color1}DISCO ${hr}
${color}Libre: ${fs_free /} ${alignr}${fs_used_perc /}%
${fs_bar 8 /}
${color1}PROCESOS ${hr}
${color}Nombre              ${color3}CPU%   ${color}Nombre              ${color3}CPU%
${color}${top name 1} ${top cpu 1} | ${top name 2} ${top cpu 2}
${top name 3} ${top cpu 3} | ${top name 4} ${top cpu 4}

${color1}ETH ${hr}
${color}Descarga: ${downspeed wlo1}${color3}${alignr}${downspeedgraph wlo1 20,100} 
${color}subida: ${upspeed wlo1} ${alignr}${color3}${upspeedgraph wlo1 20,100}

${voffset 90}
${image /home/djxs4n/Descargas/Linux-tan.jpeg -p 10,600 -s 170x100 }
${image /home/djxs4n/Descargas/ani_tec.png -p 250,145 -s 150x150 }
${image /home/djxs4n/Descargas/Mayuri-Shiina.jpeg -p 220,600 -s 170x100 }
]]
