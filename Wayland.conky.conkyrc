conky.config = {
    -- Ventanas y Bordes
    alignment = 'top_right',
    background = false,
    border_width = 0,
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_graph_borders = false,
    
    own_window = true,
    own_window_type = 'override',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 150,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_class = 'Conky',

    -- Dimensiones y Márgenes
    border_inner_margin = 15,
    border_outer_margin = 0,
    gap_x = 30,
    gap_y = 30,
    minimum_width = 450, -- Aumentado para que los 'goto' no se corten
    minimum_height = 500,

    -- Rendimiento
    double_buffer = true,
    update_interval = 0.01, -- Un pelín más alto para estabilidad
    cpu_avg_samples = 2,
    
    -- Importacion de archivos 
    lua_load = '/home/djxs4n/.config/conky/draw_bg.lua',
    lua_draw_hook_pre = 'conky_main',

    -- Estilo
    font = 'JetBrainsMono:size=10',
    default_color = 'B3FFE3',
    color1 = '#0BE08C',
    color2 = '#FF5555',
    color3 = '#9B89D9',        
}

conky.text = [[
${image /home/djxs4n/.config/conky/img/pc.png -p 25,0 -s 25x25} ${goto 60} ${color1}SISTEMA ${hr}
${goto 65}${color3}Kernel:${color1}${kernel}${goto 210}${color1}Uptime: ${color}${uptime}

${voffset 20}
${goto 65}${color1}CPU TEMP: ${color}${hwmon 1 temp 1}°C
${goto 65}${color2}RAM USO: ${color}${mem} / ${memmax}

]]
